{
  "manifest_version": 3,
  "name": "Aether Canvas",
  "version": "1.0.0",
  "description": "Apply gentle reading and focus styles to any website.",
  "icons": { "48": "icon.png" },
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["styles.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "Aether Canvas"
  }
}
